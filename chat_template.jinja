{{- '<bos>' -}}
{%- set ns = namespace(sys='') -%}
{%- set nav = namespace(last_asst=-1) -%}
{%- for m in messages -%}
  {%- if m['role'] == 'assistant' -%}
    {%- set nav.last_asst = loop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- for m in messages -%}
  {%- if m['role'] == 'system' -%}
    {%- set ns.sys = ns.sys + (m['content'] | trim) + '\n\n' -%}
  {%- endif -%}
{%- endfor -%}
{%- for m in messages -%}
  {%- if m['role'] == 'system' -%}
  {%- elif m['role'] == 'user' -%}
    {{- '<|user|>' + ns.sys + (m['content'] | trim) -}}
    {%- set ns.sys = '' -%}
  {%- elif m['role'] == 'assistant' -%}
    {{- '<|assistant|>' + (m['content'] | trim)
       + ('<|eot|>' if loop.index0 != nav.last_asst else '<eos>') -}}
  {%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}
  {{- '<|assistant|>' -}}
{%- endif -%}
